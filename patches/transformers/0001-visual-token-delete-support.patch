+    def _apply_deleted_kv_context(
+        self,
+        key_states: torch.Tensor,
+        value_states: torch.Tensor,
+        attention_mask: Optional[torch.Tensor],
+    ) -> Tuple[torch.Tensor, torch.Tensor, Optional[torch.Tensor]]:
+        deleted_positions = getattr(self.config, "current_deleted_patches", None)
+        if deleted_positions is None:
+            return key_states, value_states, attention_mask
+
+        if torch.is_tensor(deleted_positions):
+            deleted_positions = deleted_positions.to(device=key_states.device, dtype=torch.long).flatten()
+        else:
+            deleted_positions = torch.tensor(deleted_positions, device=key_states.device, dtype=torch.long).flatten()
+
+        if deleted_positions.numel() == 0:
+            return key_states, value_states, attention_mask
+
+        kv_len = key_states.shape[-2]
+        deleted_positions = deleted_positions[(deleted_positions >= 0) & (deleted_positions < kv_len)]
+        if deleted_positions.numel() == 0:
+            return key_states, value_states, attention_mask
+
+        visible = torch.ones(kv_len, dtype=torch.bool, device=key_states.device)
+        visible[deleted_positions] = False
+        visible_idx = visible.nonzero(as_tuple=True)[0]
+        if visible_idx.numel() == kv_len:
+            return key_states, value_states, attention_mask
+
+        key_states = key_states.index_select(-2, visible_idx)
+        value_states = value_states.index_select(-2, visible_idx)
+
+        if attention_mask is not None:
+            if attention_mask.dim() == 4 and attention_mask.shape[-1] >= kv_len:
+                attention_mask = attention_mask[..., :kv_len].index_select(-1, visible_idx)
+            elif attention_mask.dim() == 2 and attention_mask.shape[-1] >= kv_len:
+                attention_mask = attention_mask[..., :kv_len].index_select(-1, visible_idx)
+
+        return key_states, value_states, attention_mask
+
