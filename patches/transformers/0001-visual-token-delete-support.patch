+        def _empty_patch_tensor():
+            return torch.empty(0, device=inputs_embeds.device, dtype=torch.long)
+
+        def _select_layer_patches(patches, proportion):
+            if patches is None:
+                return _empty_patch_tensor()
+            if torch.is_tensor(patches):
+                patches = patches.to(device=inputs_embeds.device, dtype=torch.long).flatten()
+            else:
+                patches = torch.tensor(patches, device=inputs_embeds.device, dtype=torch.long).flatten()
+            if patches.numel() == 0:
+                return _empty_patch_tensor()
+            if torch.is_tensor(proportion):
+                proportion_value = float(proportion.detach().cpu())
+            else:
+                proportion_value = float(proportion)
+            proportion_value = max(0.0, min(proportion_value, 1.0))
+            top_k = int(proportion_value * patches.numel())
+            if proportion_value > 0.0 and top_k == 0:
+                top_k = 1
+            top_k = max(0, min(top_k, patches.numel()))
+            return patches[:top_k]
+
+        def _unique_cat(*parts):
+            parts = [p.to(device=inputs_embeds.device, dtype=torch.long).flatten() for p in parts if p is not None and p.numel() > 0]
+            if not parts:
+                return _empty_patch_tensor()
+            return torch.unique(torch.cat(parts, dim=0), sorted=True)
+
+        def _set_difference(values, excluded):
+            values = values.to(device=inputs_embeds.device, dtype=torch.long).flatten()
+            if values.numel() == 0:
+                return values
+            if excluded is None or excluded.numel() == 0:
+                return values
+            excluded = excluded.to(device=inputs_embeds.device, dtype=torch.long).flatten()
+            return values[~torch.isin(values, excluded)]
+
+        def _visible_kv_length(total_len, deleted_positions):
+            if deleted_positions is None or deleted_positions.numel() == 0:
+                return total_len
+            deleted_positions = deleted_positions.to(device=inputs_embeds.device, dtype=torch.long).flatten()
+            valid_deleted = deleted_positions[(deleted_positions >= 0) & (deleted_positions < total_len)]
+            if valid_deleted.numel() == 0:
+                return total_len
+            return total_len - torch.unique(valid_deleted).numel()
+
+        def _visible_kv_positions(total_len, deleted_positions):
+            positions = torch.arange(total_len, device=inputs_embeds.device, dtype=torch.long)
+            if deleted_positions is None or deleted_positions.numel() == 0:
+                return positions
+            deleted_positions = deleted_positions.to(device=inputs_embeds.device, dtype=torch.long).flatten()
+            valid_deleted = deleted_positions[(deleted_positions >= 0) & (deleted_positions < total_len)]
+            if valid_deleted.numel() == 0:
+                return positions
+            return positions[~torch.isin(positions, torch.unique(valid_deleted))]
 
